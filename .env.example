# Postgres
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
DATABASE_URL=

# Redis
REDIS_PORT=
REDIS_ADDR=

# Kafka
KAFKA_BROKERS=

# API
# 8080 suele estar ocupado por otros servicios locales — 8095 evita el
# choque sin tocar nada dentro de Docker.
PORT=

# Auth (JWT)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=
AUTH_USERNAME=
AUTH_PASSWORD=

# Risk Service (Python)
RISK_PORT=
# Monto sobre el que un pago se manda a revision, en unidad minima.
# 10000000 = 100.000 COP
REVIEW_AMOUNT_MINOR=
# Intents recientes del mismo comercio que disparan ABNORMAL_VELOCITY
VELOCITY_MAX_RECENT=
VELOCITY_WINDOW_SECONDS=
SUSPICIOUS_REFERENCE_PREFIXES=

# Reconciliation Scheduler (Python) — el reloj, replica unica
SCHEDULER_METRICS_PORT=
# Cada cuanto se publica el tick de conciliacion, en segundos
RECONCILIATION_INTERVAL_SECONDS=

# Reconciliation Worker (Python)
RECONCILIATION_METRICS_PORT=
# Solo para la demo: cierra por antiguedad en vez de respetar el
# expires_at del core, para no esperar 30 minutos en la sustentacion.
# Vacio en operacion normal.
EXPIRY_OVERRIDE_MINUTES=

# Comun
LOG_LEVEL=
